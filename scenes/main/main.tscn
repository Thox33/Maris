[gd_scene load_steps=7 format=3]

; Main scene — game world.
;   Main (Node2D)
;     ├── World (WorldGenerator) — procedural underwater terrain
;     ├── Players (Node2D) — container for spawned player scenes
;     ├── Items (Node2D) — container for spawned item drop entities
;     ├── PlayerSpawner (MultiplayerSpawner)
;     ├── ItemSpawner (MultiplayerSpawner)
;     ├── InventoryManager (Node) — host-authoritative inventory sync
;     ├── ScreenEffects (Node) — fullscreen camera-layer effects
;     │     └── CanvasLayer (layer 100)
;     │           └── UnderwaterOverlay (ColorRect + underwater shader)
;     └── SessionMenu

[ext_resource type="Script" path="res://scenes/main/main.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/world/world_generator.tscn" id="2"]
[ext_resource type="Script" path="res://scenes/main/inventory_manager.gd" id="3"]
[ext_resource type="PackedScene" path="res://scenes/ui/session_menu.tscn" id="4"]
[ext_resource type="Script" path="res://scripts/main/screen_effects.gd" id="5"]
[ext_resource type="Shader" path="res://assets/shaders/underwater.gdshader" id="6"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_underwater"]
shader = ExtResource("6")

[node name="Main" type="Node2D"]
script = ExtResource("1")

[node name="World" parent="." instance=ExtResource("2")]

[node name="Players" type="Node2D" parent="."]

[node name="Items" type="Node2D" parent="."]

[node name="PlayerSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Players")

[node name="ItemSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Items")

[node name="InventoryManager" type="Node" parent="."]
script = ExtResource("3")

[node name="ScreenEffects" type="Node" parent="."]
script = ExtResource("5")

[node name="CanvasLayer" type="CanvasLayer" parent="ScreenEffects"]
layer = 100

[node name="UnderwaterOverlay" type="ColorRect" parent="ScreenEffects/CanvasLayer"]
material = SubResource("ShaderMaterial_underwater")
mouse_filter = 2

[node name="SessionMenu" parent="." instance=ExtResource("4")]
