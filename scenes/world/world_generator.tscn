[gd_scene load_steps=5 format=3]

; World generator scene:
;   WorldGenerator (Node2D) — procedural generation logic
;     ├── TerrainLayer (TileMapLayer) — tile grid with terrain_tileset.tres
;     ├── PlantLayer (TileMapLayer) — plant tiles, carries sway shader
;     └── ChunkManager (Node) — orchestrates chunk loading/unloading/network

[ext_resource type="Script" path="res://scenes/world/world_generator.gd" id="1"]
[ext_resource type="TileSet" path="res://assets/tilesets/terrain_tileset.tres" id="2"]
[ext_resource type="Script" path="res://scripts/world/chunk_manager.gd" id="3"]
[ext_resource type="Script" path="res://scripts/world/chunk_debug_overlay.gd" id="4"]
[ext_resource type="Script" path="res://scripts/world/structure_manager.gd" id="5"]

[node name="WorldGenerator" type="Node2D"]
script = ExtResource("1")

[node name="TerrainLayer" type="TileMapLayer" parent="."]
tile_set = ExtResource("2")
modulate = Color(1, 1, 1, 0)

[node name="BaseVisualLayer" type="TileMapLayer" parent="."]
tile_set = ExtResource("2")

[node name="PlantLayer" type="TileMapLayer" parent="."]
tile_set = ExtResource("2")

[node name="DepthSorted" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Players" type="Node2D" parent="DepthSorted"]
y_sort_enabled = true

[node name="ChunkManager" type="Node" parent="."]
script = ExtResource("3")

[node name="StructureManager" type="Node" parent="."]
script = ExtResource("5")

[node name="ChunkDebugCanvas" type="CanvasLayer" parent="."]
layer = 110
follow_viewport_enabled = true

[node name="ChunkDebugOverlay" type="Node2D" parent="ChunkDebugCanvas"]
script = ExtResource("4")
