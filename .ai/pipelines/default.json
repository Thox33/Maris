{
  "name": "default",
  "description": "Default autonomous pipeline for concrete feature work.",
  "stages": [
    {
      "name": "planner",
      "role": "planner",
      "provider": "codex",
      "fallback_providers": ["claude"],
      "enabled": true
    },
    {
      "name": "builder",
      "role": "builder",
      "provider": "codex",
      "fallback_providers": ["claude"],
      "enabled": true
    },
    {
      "name": "verify",
      "role": "verify",
      "provider": "powershell",
      "enabled": true,
      "commands": [
        {
          "name": "project-parse",
          "command": "godot --headless --quit --path ."
        },
        {
          "name": "main-scene-boot",
          "command": "godot --headless --path . --scene res://scenes/main/main.tscn --quit-after 1"
        },
        {
          "name": "world-generator-boot",
          "command": "godot --headless --path . --scene res://scenes/world/world_generator.tscn --quit-after 1"
        }
      ]
    },
    {
      "name": "reviewer",
      "role": "reviewer",
      "provider": "codex",
      "fallback_providers": ["claude"],
      "enabled": true,
      "accepted_review_findings": []
    }
  ],
  "autonomy": {
    "run_without_confirmation": true,
    "stop_on_reviewer_fail": true,
    "max_fix_loops": 0
  },
  "post_run": {
    "summarize_iterations": true,
    "retrospective": true,
    "suggest_commit": true,
    "cleanup_run_artifacts": true
  }
}
